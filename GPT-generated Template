# README.md
"""
## Snowflake → Google Sheets Starter Template

### What It Does
- Pulls Snowflake data using a Flask API
- Secure authentication via Snowflake OAuth (externalbrowser)
- Pipes results into a Google Sheet

### Setup
1. Install dependencies:
    ```bash
    pip install -r requirements.txt
    ```

2. Copy `.env.example` to `.env` and fill in your Snowflake credentials.

3. Run the server:
    ```bash
    python app.py
    ```

4. (Optional) Expose the server with ngrok:
    ```bash
    ngrok http 8080
    ```

5. In Google Sheets, paste the provided `sheets_client.gs` into `Apps Script`, update the URL, and refresh from the menu.

### Notes
- API_KEY can be used to add security (optional)
- Token caching avoids repeat OAuth prompts

"""

# sheets_client.gs
// Include this in Google Sheets Apps Script editor
// Adds a menu to refresh data from your Flask API

// Replace API_URL with your ngrok or deployed endpoint
const CONFIG = {
  API_URL: 'https://YOUR_TUNNEL.ngrok-free.app/api/data',
  SHEET_NAMES: {
    INPUT: 'Visuals',
    DATA: 'Data'
  },
  CELL_REFS: {
    CUSTOMER_ID: 'C2'
  }
};

function onOpen() {
  const ui = SpreadsheetApp.getUi();
  ui.createMenu('Snowflake Tools')
    .addItem('Refresh Data', 'refreshData')
    .addSeparator()
    .addItem('Clear All Data', 'clearAllData')
    .addItem('Show Settings', 'showSettings')
    .addToUi();
}

function refreshData() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet();
  const inputSheet = sheet.getSheetByName(CONFIG.SHEET_NAMES.INPUT);
  const dataSheet = sheet.getSheetByName(CONFIG.SHEET_NAMES.DATA);
  const customerId = inputSheet.getRange(CONFIG.CELL_REFS.CUSTOMER_ID).getValue();

  if (!customerId) throw new Error("Missing Customer ID in cell " + CONFIG.CELL_REFS.CUSTOMER_ID);

  const response = UrlFetchApp.fetch(CONFIG.API_URL, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify({ customer_id: customerId }),
    muteHttpExceptions: true
  });

  const data = JSON.parse(response.getContentText());
  dataSheet.getRange('A2:E').clearContent();
  dataSheet.getRange('K2:Q').clearContent();

  if (data.deposits?.length) {
    const rows = data.deposits.map(r => [new Date(r[0]), ...r.slice(1)]);
    dataSheet.getRange(2, 1, rows.length, 5).setValues(rows);
  }
  if (data.orders?.length) {
    const rows = data.orders.map(r => [new Date(r[0]), ...r.slice(1)]);
    dataSheet.getRange(2, 11, rows.length, 7).setValues(rows);
  }
}

function clearAllData() {
  const dataSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET_NAMES.DATA);
  dataSheet.getRange('A2:E').clearContent();
  dataSheet.getRange('K2:Q').clearContent();
}

function showSettings() {
  const ui = SpreadsheetApp.getUi();
  ui.alert("Endpoint: " + CONFIG.API_URL);
}
